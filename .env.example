# Telegram API credentials — get these free at https://my.telegram.org
# (API development tools -> create an app). Copy this file to `.env` and fill in.
# NEVER commit `.env` — it is gitignored. These are placeholders only.
TELEGRAM_API_ID=YOUR_API_ID_HERE
TELEGRAM_API_HASH=YOUR_API_HASH_HERE

# Optional session name (default: forwarder_session1). Session file is written to
# $DATA_DIR (default ~/.local/share/tg-cli) and is also gitignored (*.session).
TG_SESSION_NAME=forwarder_session1

# Forwarding config (optional — can also be passed via CLI flags).
SOURCE_CHANNELS=
DEST_CHANNELS=
FORWARD_PATH=downloads
